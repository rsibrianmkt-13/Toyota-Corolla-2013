<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Velocidad por GPS -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Estado real de Wi-Fi en la barra superior -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Solo para buscar letras (LRCLIB). Nada más usa Internet. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Kilometraje GPS en segundo plano (rendimiento de combustible). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Estado real de Bluetooth (encendido / teléfono conectado) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Brillo: permiso especial que se concede a mano en Ajustes -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Listar apps instaladas para elegir Android Auto, Radio, Música BT… (uso personal, no Play Store) -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Actualizarse desde GitHub (rama apk) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <application
        android:name=".CorollaDashApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.CorollaDash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density"
            android:windowSoftInputMode="stateAlwaysHidden"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">

            <!-- A: abrir como app normal -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- B: candidata a launcher (HOME). Solo se activa si TÚ la eliges en Ajustes; es reversible. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Necesario para leer las MediaSession activas (metadatos de música Bluetooth) -->
        <service
            android:name=".media.MediaListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name=".fuel.OdometerService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <receiver
            android:name=".update.InstallReceiver"
            android:exported="false" />
    </application>
</manifest>
